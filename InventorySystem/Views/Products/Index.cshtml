@model IEnumerable<InventorySystem.Models.Product>

@{
    ViewData["Title"] = "Products Catalog";
    var categories = ViewBag.Categories as SelectList;
    var search = ViewBag.Search as string;
    var lowStock = ViewBag.LowStock as bool? ?? false;
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">📦 Products Catalog</h3>
            <p class="text-muted small mb-0">Manage inventory items, pricing, and stock thresholds.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="ti ti-plus"></i> Add New Product
            </a>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="ti ti-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Search by product name..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoryId" asp-items="categories" class="form-select">
                        <option value="">-- All Categories --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-center gap-3">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" name="lowStock" value="true" id="lowStockToggle" @(lowStock ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label small fw-semibold" for="lowStockToggle">Low Stock</label>
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm px-3">Filter</button>
                    @if (!string.IsNullOrEmpty(search) || lowStock || categories?.SelectedValue != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters"><i class="ti ti-x"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Supplier</th>
                            <th>Unit Price</th>
                            <th>Stock Level</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@p.Name</div>
                                        <div class="text-muted small text-truncate" style="max-width: 250px;">@(p.Description ?? "-")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary">@(p.Category?.Name ?? "General")</span>
                                    </td>
                                    <td class="text-muted small">
                                        @(p.Supplier?.Name ?? "-")
                                    </td>
                                    <td class="fw-semibold">
                                        @p.Price.ToString("C2")
                                    </td>
                                    <td>
                                        <span class="fw-bold @(p.IsOutOfStock ? "text-danger" : p.IsLowStock ? "text-warning" : "text-dark")">
                                            @p.Quantity
                                        </span>
                                        <span class="text-muted small">/ min @p.MinStock</span>
                                    </td>
                                    <td>
                                        @if (p.IsOutOfStock)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="ti ti-alert-circle me-1"></i> Out of Stock
                                            </span>
                                        }
                                        else if (p.IsLowStock)
                                        {
                                            <span class="badge bg-warning-subtle text-warning">
                                                <i class="ti ti-alert-triangle me-1"></i> Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="ti ti-check me-1"></i> In Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="Stock" asp-action="StockIn" asp-route-productId="@p.Id" class="btn btn-outline-success" title="Quick Stock In">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                            <a asp-controller="Stock" asp-action="StockOut" asp-route-productId="@p.Id" class="btn btn-outline-danger" title="Quick Stock Out">
                                                <i class="ti ti-minus"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="Edit">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#deleteModal-@p.Id" title="Delete">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@p.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-sm text-start">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h6 class="modal-title fw-bold text-danger">Confirm Delete</h6>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        Are you sure you want to remove <strong>@p.Name</strong> from the inventory?
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="ti ti-box fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No products found matching your search criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
