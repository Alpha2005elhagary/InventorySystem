<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    
    <!-- Google Font: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tabler Icons Webfont -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css" />
    
    <!-- Custom Theme & Bootstrap CSS -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <!-- Mobile Overlay -->
    <div class="overlay" id="overlay"></div>

    <!-- Sidebar Navigation -->
    <aside class="sidebar shadow-sm" id="sidebar">
        <div class="logo-area">
            <span class="btn-icon btn-sm bg-primary text-white rounded-3">
                <i class="ti ti-box fs-5"></i>
            </span>
            <span class="logo-text fw-bold fs-5 tracking-wide">
                Inventory<span class="text-primary">Hub</span>
            </span>
        </div>

        <nav class="nav flex-column py-3">
            <a asp-controller="Home" asp-action="Index" class="nav-link">
                <i class="ti ti-layout-dashboard"></i>
                <span class="nav-text">Dashboard</span>
            </a>
            
            <a asp-controller="Products" asp-action="Index" class="nav-link">
                <i class="ti ti-packages"></i>
                <span class="nav-text">Products</span>
            </a>

            <a asp-controller="Categories" asp-action="Index" class="nav-link">
                <i class="ti ti-category"></i>
                <span class="nav-text">Categories</span>
            </a>

            <a asp-controller="Suppliers" asp-action="Index" class="nav-link">
                <i class="ti ti-truck-delivery"></i>
                <span class="nav-text">Suppliers</span>
            </a>

            <div class="px-3 py-2 text-uppercase text-muted small fw-semibold nav-text" style="font-size: 11px;">
                Stock Ops
            </div>

            <a asp-controller="Stock" asp-action="Index" class="nav-link">
                <i class="ti ti-arrows-exchange"></i>
                <span class="nav-text">Stock Ledger</span>
            </a>

            <a asp-controller="Stock" asp-action="StockIn" class="nav-link text-success">
                <i class="ti ti-arrow-bar-to-down"></i>
                <span class="nav-text">Stock In (+)</span>
            </a>

            <a asp-controller="Stock" asp-action="StockOut" class="nav-link text-danger">
                <i class="ti ti-arrow-bar-to-up"></i>
                <span class="nav-text">Stock Out (-)</span>
            </a>
        </nav>
    </aside>

    <!-- Topbar -->
    <header class="topbar border-bottom bg-white d-flex align-items-center justify-content-between px-4" id="topbar">
        <div class="d-flex align-items-center gap-3">
            <!-- Sidebar toggle buttons -->
            <button class="btn btn-icon btn-sm btn-light rounded-circle d-none d-lg-inline-flex" id="toggleBtn" title="Toggle Sidebar">
                <i class="ti ti-menu-2"></i>
            </button>
            <button class="btn btn-icon btn-sm btn-light rounded-circle d-lg-none" id="mobileBtn" title="Open Menu">
                <i class="ti ti-menu-2"></i>
            </button>

            <!-- Quick search -->
            <form asp-controller="Products" asp-action="Index" method="get" class="d-none d-md-flex align-items-center position-relative">
                <i class="ti ti-search position-absolute text-muted ms-3"></i>
                <input type="text" name="search" class="form-control form-control-sm ps-5 rounded-pill bg-light border-0" placeholder="Search SKU, item name..." style="width: 260px;" />
            </form>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center gap-2">
                <i class="ti ti-plus"></i>
                <span class="d-none d-sm-inline">Add Product</span>
            </a>

            <!-- Notification bell -->
            <div class="dropdown">
                <button class="btn btn-icon btn-sm btn-light rounded-circle position-relative" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-bell"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="width: 280px;">
                    <li class="dropdown-header fw-bold text-dark">Notifications</li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <a class="dropdown-item py-2 small d-flex align-items-center gap-2" asp-controller="Products" asp-action="Index" asp-route-lowStock="true">
                            <span class="badge bg-warning-subtle text-warning"><i class="ti ti-alert-triangle"></i></span>
                            <div>
                                <div class="fw-semibold">Low stock warnings</div>
                                <div class="text-muted small">Check inventory alerts</div>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- User avatar dropdown -->
            <div class="dropdown">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar avatar-sm avatar-indicators avatar-online">
                            <span class="avatar-initials bg-primary text-white rounded-circle fw-bold">
                                @(User.Identity.Name?.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpper() ?? "US")
                            </span>
                        </div>
                        <span class="d-none d-md-inline small fw-semibold text-dark">@User.Identity.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                        <li class="px-3 py-2 text-muted small border-bottom">
                            <strong>Signed in as</strong><br>
                            <span class="text-dark fw-semibold">@User.Identity.Name</span>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="p-0 m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center gap-2">
                                    <i class="ti ti-logout"></i> Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                }
                else
                {
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar avatar-sm">
                            <span class="avatar-initials bg-secondary text-white rounded-circle fw-bold">
                                <i class="ti ti-user"></i>
                            </span>
                        </div>
                        <span class="d-none d-md-inline small fw-semibold text-dark">Account</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                        <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Login"><i class="ti ti-login"></i> Sign In</a></li>
                        <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Register"><i class="ti ti-user-plus"></i> Register</a></li>
                    </ul>
                }
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="content p-4" id="content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="ti ti-circle-check fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="ti ti-alert-circle fs-5"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()

        <footer class="mt-5 pt-4 text-center text-muted small border-top">
            &copy; 2026 <strong>InventoryHub</strong> — Built with ASP.NET Core MVC & Entity Framework Core
        </footer>
    </main>

    <!-- Theme Bundle JS (Bootstrap 5, ApexCharts & Interactive Controls) -->
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
