@model InventorySystem.ViewModels.StockTransactionViewModel

@{
    ViewData["Title"] = "Record Stock In";
}

<div class="container py-2" style="max-width: 600px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
            <i class="ti ti-arrow-left"></i> Back to Ledger
        </a>
        <h3 class="fw-bold text-success mb-1">
            <i class="ti ti-arrow-bar-to-down me-1"></i> Record Stock In (Replenishment)
        </h3>
        <p class="text-muted small">Receive new stock into the warehouse and automatically increase available quantity.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="StockIn" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2"></div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label fw-semibold small">Select Product <span class="text-danger">*</span></label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="form-select" required>
                        <option value="">-- Choose Item --</option>
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label fw-semibold small">Quantity Received <span class="text-danger">*</span></label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" placeholder="e.g. 50" required />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-semibold small">Notes / Shipment Details / PO Number</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="e.g. Supplier Invoice #88432 - Received in good condition"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-success px-4 d-flex align-items-center gap-2">
                        <i class="ti ti-check"></i> Add to Stock
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
