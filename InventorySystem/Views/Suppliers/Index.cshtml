@model IEnumerable<InventorySystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers Directory";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">🚚 Suppliers Directory</h3>
            <p class="text-muted small mb-0">Vendors and distributor contact information.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="ti ti-plus"></i> Add New Supplier
            </a>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var s in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0 text-dark">@s.Name</h5>
                                <span class="badge bg-info-subtle text-info">@s.Products.Count supplied</span>
                            </div>

                            <div class="mt-3 small text-muted">
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <i class="ti ti-phone text-secondary"></i>
                                    <span>@(s.Phone ?? "No phone provided")</span>
                                </div>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <i class="ti ti-mail text-secondary"></i>
                                    <span>@(s.Email ?? "No email provided")</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ti ti-map-pin text-secondary"></i>
                                    <span>@(s.Address ?? "No address recorded")</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="text-muted small">ID: #@s.Id</span>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Remove supplier? Products will remain unassigned.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Supplier">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
