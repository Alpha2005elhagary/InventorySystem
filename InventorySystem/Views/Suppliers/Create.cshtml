@model InventorySystem.Models.Supplier

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="container py-2" style="max-width: 600px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
            <i class="ti ti-arrow-left"></i> Back to Suppliers
        </a>
        <h3 class="fw-bold mb-1">Add Supplier</h3>
        <p class="text-muted small">Register a vendor or distributor for product purchasing.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small">Company / Vendor Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. ABC Electronics Ltd" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="+20 100 123 4567" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="supplier@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label fw-semibold small">Office / Warehouse Address</label>
                    <input asp-for="Address" class="form-control" placeholder="City, Street, Building..." />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>
