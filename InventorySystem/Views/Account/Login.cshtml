@model InventorySystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <span class="btn-icon btn-md bg-primary text-white rounded-4 mb-2">
                <i class="ti ti-box fs-4"></i>
            </span>
            <h4 class="fw-bold">Welcome Back</h4>
            <p class="text-muted small">Sign in to access InventoryHub management console</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    
                    <div asp-validation-summary="All" class="alert alert-danger border-0 small py-2 mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="admin@inventory.local" autofocus required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                        <label asp-for="RememberMe" class="form-check-label small" for="rememberMe"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
                </form>

                <div class="mt-4 pt-3 border-top text-center">
                    <div class="alert alert-light border small text-muted text-start mb-0 py-2">
                        <div class="fw-bold text-dark mb-1"><i class="ti ti-key me-1"></i> Default Admin Credentials:</div>
                        <div>Email: <code>admin@inventory.local</code></div>
                        <div>Password: <code>Admin123!</code></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3 text-muted small">
            Don't have an account? <a asp-action="Register" asp-route-returnUrl="@Model?.ReturnUrl" class="text-primary fw-semibold">Create one</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

